{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user_api_schema.json",
  "title": "Fake Store API user response",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "password": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "object",
      "properties": {
        "firstname": {
          "type": "string",
          "minLength": 1
        },
        "lastname": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["firstname", "lastname"],
      "additionalProperties": true
    },
    "address": {
      "type": "object",
      "properties": {
        "geolocation": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "string",
              "minLength": 1
            },
            "long": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["lat", "long"],
          "additionalProperties": true
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "street": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer"
        },
        "zipcode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["geolocation", "city", "street", "number", "zipcode"],
      "additionalProperties": true
    },
    "phone": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["id", "email", "username", "password", "name", "address", "phone"],
  "additionalProperties": true
}
